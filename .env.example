# Docker Compose placeholders. Copy to .env and fill secrets locally.
MYSQL_DATABASE=oniria_city
MYSQL_USER=oniria_user
MYSQL_PASSWORD=<strong-password>
MYSQL_ROOT_PASSWORD=<strong-password>

# Public frontend origin(s) allowed by the backend CORS middleware.
# Use comma-separated values for multiple domains.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

ONIRIA_ADMIN_UPDATE_PASSWORD=false
