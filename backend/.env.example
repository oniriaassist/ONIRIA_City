APP_NAME=ONIRIA City Backend
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api
PORT=7000

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# MySQL 8.4 only.
# Use either DATABASE_URL or the MYSQL_* fields below.
# Raw MYSQL_PASSWORD contains the actual password, not URL encoding.
# Special URL characters must be percent-encoded only inside DATABASE_URL.
# Supported URL schemes: mysql://, mysql+pymysql://, mysql+aiomysql://.
DATABASE_URL=
# Local development: 127.0.0.1
# Docker Compose: mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=oniria_city
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_POOL_SIZE=10
MYSQL_MAX_OVERFLOW=20
DATABASE_MIN_SIZE=1
DATABASE_MAX_SIZE=5

LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120

ONIRIA_ADMIN_FULL_NAME=ONIRIA Administrator
ONIRIA_ADMIN_EMAIL=
ONIRIA_ADMIN_PASSWORD=
ONIRIA_ADMIN_PASSWORD_CONFIRM=
ONIRIA_ADMIN_UPDATE_PASSWORD=false

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

MAIL_PROVIDER=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=
MAIL_FROM_NAME=ONIRIA City
SALES_NOTIFICATION_EMAIL=
SALES_NOTIFICATION_EMAILS=
REPLY_TO_EMAIL=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_BROCHURE_TEMPLATE_NAME=
WHATSAPP_BROCHURE_TEMPLATE_LANGUAGE=en

BROCHURE_PDF_FILE=app/assets/ONIRIA_City_Brochure.pdf
