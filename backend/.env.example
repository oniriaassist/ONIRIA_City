APP_NAME=Roho Backend
APP_ENV=local
APP_DEBUG=true
API_PREFIX=/api
PORT=7000

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL/Supabase.
# Use either DATABASE_URL or the POSTGRES_* fields below.
# Raw POSTGRES_PASSWORD contains the actual password, not URL encoding.
# Special URL characters must be percent-encoded only inside DATABASE_URL.
# Supported URL schemes: postgresql://, postgres://, postgresql+asyncpg://.
DATABASE_URL=
# Local development: 127.0.0.1
# Docker Compose: postgres
# Supabase: prefer DATABASE_URL from Project Settings > Database.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DATABASE=oniria_city
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
DATABASE_MIN_SIZE=1
DATABASE_MAX_SIZE=5

LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=120

ONIRIA_ADMIN_FULL_NAME=ONIRIA Administrator
ONIRIA_ADMIN_EMAIL=
ONIRIA_ADMIN_PASSWORD=
ONIRIA_ADMIN_PASSWORD_CONFIRM=
ONIRIA_ADMIN_UPDATE_PASSWORD=false

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

MAIL_PROVIDER=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
MAIL_FROM=
MAIL_FROM_NAME=Roho
SALES_NOTIFICATION_EMAIL=
SALES_NOTIFICATION_EMAILS=
REPLY_TO_EMAIL=

WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_BROCHURE_TEMPLATE_NAME=
WHATSAPP_BROCHURE_TEMPLATE_LANGUAGE=en

BROCHURE_PDF_FILE=app/assets/ONIRIA_City_Brochure.pdf
